{
  "version": "schulmanager-get-letters-v1",
  "rules": [
    { "path": "results[].status", "mode": "type" },
    { "path": "results[].data[].id", "mode": "type" },
    { "path": "results[].data[].createdAt", "mode": "type" },
    { "path": "results[].data[].sentDate", "mode": "type" },
    { "path": "results[].data[].studentStatuses[].id", "mode": "type" },
    { "path": "results[].data[].studentStatuses[].readTimestamp", "mode": "type" },
    { "path": "results[].data[].studentStatuses[].sentTimestamp", "mode": "type" },
    { "path": "systemStatusMessages[].id", "mode": "type" },
    { "path": "systemStatusMessages[].level", "mode": "type" },
    { "path": "systemStatusMessages[].platforms[]", "mode": "type" },
    { "path": "systemStatusMessages[].relevantModules[]", "mode": "type" },
    { "path": "systemStatusMessages[].roles[]", "mode": "type" },
    { "path": "systemStatusMessages[].visibilities[]", "mode": "type" }
  ]
}
